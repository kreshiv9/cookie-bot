{
  "manifest_version": 3,
  "name": "Cookie Bot v2",
  "version": "2.0.0",
  "description": "Quick safety check for cookie/privacy practices with AI-assisted wording.",
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Cookie Bot v2",
    "default_popup": "popup.html"
  },
  "permissions": ["activeTab", "scripting", "cookies", "storage"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
