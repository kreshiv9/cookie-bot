GROQ_API_KEY=your_groq_api_key_here
# Optional: override default model
GROQ_MODEL=llama-3.1-8b-instant
# Optional: change server port
# PORT=3000
# Optional: restrict CORS (comma-separated origins, e.g., https://yourdomain.com,chrome-extension://your_extension_id)
ALLOWED_ORIGINS=
# Optional: rate limit per minute
RATE_LIMIT_PER_MIN=60
